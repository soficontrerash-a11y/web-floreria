# Configuración de Correo para Reportes Semanales — Florería Memorial
# Para usar con Gmail:
# 1. Ingresá a tu cuenta de Google > Seguridad (o https://myaccount.google.com/apppasswords)
# 2. Creá una "Contraseña de Aplicación" para "Correo / Web" (genera 16 letras, ej: abcd efgh ijkl mnop)
# 3. Copiá este archivo a .env.local y colocá los datos:

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=floresdelparquemontoya@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion_aqui
REPORT_RECIPIENT=soficontrerash@gmail.com
